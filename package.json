{
  "name": "pi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "pi resources (skills, prompts) and a sandbox runner: stock pi CLI + one extension + a wrapper that writes report.json",
  "type": "module",
  "engines": {
    "node": ">=26.10.0"
  },
  "bin": {
    "pi-agent": "dist/pi-agent.js"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/scenario-profile.js",
      "./src/project/index.ts",
      "./src/metrics/index.ts",
      "./src/session-upload/index.ts"
    ],
    "skills": [
      "./skills",
      "!skills/README.md"
    ],
    "prompts": [
      "./prompts/*.md",
      "!prompts/README.md"
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/md-loader.mjs --test 'src/**/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/pi-agent.js",
    "dev": "node --import ./scripts/md-loader.mjs src/wrapper/main.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  }
}
